# Copy to .env and fill in. docker-compose.yml reads these.
# .env is gitignored; this template is not. Never commit real values.

# 32 random bytes, hex-encoded (64 chars): openssl rand -hex 32
# Losing this makes every stored secret unrecoverable. Back it up.
ENCRYPTION_KEY=

# Cloudflare Access team domain, without the .cloudflareaccess.com suffix.
CF_ACCESS_TEAM_DOMAIN=

# Audience tag of the Cloudflare Access application protecting /admin/*.
CF_ACCESS_ADMIN_AUDIENCE=

# Audience GitHub Actions OIDC tokens must carry — the server URL clients
# request the token for, e.g. https://secrets.example.com
OIDC_AUDIENCE=
